# =============================================================
# GoTec.AI - Root .gitignore
# =============================================================

# --- Environment & secrets (NEVER commit) ---
.env
.env.local
.env.*.local
*.env
!.env.example

# --- Python (Backend) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / Next.js (Frontend) ---
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
.npm
.eslintcache
.turbo

# --- Generated outputs (regenerated at runtime) ---
backend/generated/
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.glb
*.gltf
*.obj
*.fbx
*.svg
!docs/**/*.svg
!*.ico
!*.png.b64

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
backend/logs/

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- OS files ---
$RECYCLE.BIN/
*.lnk

# --- Testing / Coverage ---
.coverage
htmlcov/
coverage/
.tox/

# --- Docker (if added later) ---
*.pid
.dockerignore-target

# --- Misc ---
*.bak
*.tmp
*.swp
.cache/
.parcel-cache/
