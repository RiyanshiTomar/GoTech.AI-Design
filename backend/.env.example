# =============================================================
# GoTec.AI - Backend Environment Variables
# =============================================================
# Copy this file to ".env" and fill in real values.
# The .env file is gitignored and must NEVER be committed.
# =============================================================

# ----- Hugging Face API Token (REQUIRED for real AI output) -----
# Get a free token at: https://huggingface.co/settings/tokens
# Create token -> Type: "Fine-grained" -> Preset: "Inference"
# Free tier includes: Mistral-7B, SDXL, TripoSR (with rate limits)
HF_TOKEN=hf_your_token_here

# ----- Frontend URL (for CORS) -----
# Change this in production to your deployed frontend domain
FRONTEND_URL=http://localhost:3000

# ----- Optional: Server config -----
# HOST=127.0.0.1
# PORT=8000
