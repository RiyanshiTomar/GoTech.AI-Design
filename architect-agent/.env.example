# The agent calls an LLM through Aider/litellm. Set ONE provider key and the matching model.
# --- Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# ARCH_MODEL=anthropic/claude-sonnet-4-5
# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# ARCH_MODEL=gpt-4o
# --- Hugging Face token only (quality depends on the model; untested for this task) ---
# HUGGINGFACE_API_KEY=hf_...
# ARCH_MODEL=huggingface/Qwen/Qwen2.5-Coder-32B-Instruct

# Optional
# ARCH_PORT=8000
# ARCH_WORKSPACE=./workspace
